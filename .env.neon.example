# =============================================================================
# Magic Vault: Neon (hosted database and auth)
# =============================================================================
# For `pnpm dev` against a Neon project. Copy this file to .env and fill in
# the REQUIRED section. Everything under "Optional features" can be left as
# is: unset means the feature is off.
#
# VITE_* values are baked into the web bundle at build time, so they're public
# and need a rebuild to change. Never put a secret in a VITE_* variable.


# =============================================================================
# 1. REQUIRED
# =============================================================================

AUTH_PROVIDER=neon
VITE_AUTH_PROVIDER=neon

# Origin the web app is served from (CORS, links in Discord posts).
WEB_URL=http://localhost:5173
PORT=3001

# Random string. Signs admin impersonation tokens.
IMPERSONATION_SECRET=

# From your project at neon.com.
DATABASE_URL=
NEON_AUTH_URL=
VITE_NEON_AUTH_URL=
VITE_NEON_DATA_API_URL=


# =============================================================================
# 2. WEB APP BUILD (public, baked into the bundle)
# =============================================================================

VITE_APP_ENV=local
# Must match the latest firmware release in main.ino.
VITE_LATEST_FIRMWARE_VERSION=1.0.1
# Leave empty to call /api on the same origin (the Vite proxy in dev). Set
# only when the API is served from a different origin.
# VITE_API_URL=


# =============================================================================
# 3. OPTIONAL FEATURES (unset = off)
# =============================================================================

# --- Shareable monitor links -------------------------------------------------
# Random string. Signs no-login monitor links. Changing it invalidates every
# link already shared.
MONITOR_LINK_SECRET=

# --- Object storage (scan photos and sound clips) ----------------------------
# Neon Object Storage or any S3-compatible private bucket. Files are served
# through short-lived presigned URLs. Empty bucket = store them in Postgres.
# Move existing images with `pnpm --filter @magic-vault/server migrate:scan-images`.
SCAN_IMAGE_BUCKET=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Billing (Stripe) --------------------------------------------------------
# Unset = billing off: every org is unlimited and the billing UI is hidden.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_BUSINESS=
# Free plan limits: scans per day, sorters connected at once (across every
# browser), sound rules and Discord notification rules (both across all
# games). Business orgs are unlimited.
FREE_PLAN_DAILY_SCAN_LIMIT=50
FREE_PLAN_MAX_CONNECTED_SORTERS=1
FREE_PLAN_MAX_SOUND_RULES=1
FREE_PLAN_MAX_NOTIFICATION_RULES=1

# --- Discord bot (packages/bot) ----------------------------------------------
# Token and client ID from the Discord Developer Portal.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Random string shared by the bot and the server.
BOT_API_SECRET=
# How the bot and server reach each other.
SERVER_URL=http://localhost:3001
BOT_URL=http://localhost:3002
BOT_PORT=3002
# Registers commands to one server instantly instead of globally (dev only).
DISCORD_DEV_GUILD_ID=

# --- Donations (Buy Me a Coffee) ---------------------------------------------
# Posts each donation to a Discord channel through the bot.
# BUY_ME_A_COFFEE_WEBHOOK_SECRET=
# DISCORD_DONATION_CHANNEL_ID=

# --- Error tracking (Rollbar) ------------------------------------------------
# The client token is public (built into the JS).
ROLLBAR_SERVER_TOKEN=
VITE_ROLLBAR_ACCESS_TOKEN=


# =============================================================================
# 4. TUNING AND DEBUGGING (defaults are fine)
# =============================================================================

# --- Admin card sync job -----------------------------------------------------
# Cards embedded in parallel, and cards per database insert.
VECTORIZE_CONCURRENCY=1
SYNC_INSERT_BATCH_SIZE=50
# SYNC_VECTORIZE_CONCURRENCY=
# SYNC_IMAGE_FETCH_DELAY_MS=200
# SYNC_DB_POOL_MAX=3
# SYNC_DB_IDLE_TIMEOUT_MS=60000
# SYNC_DB_CONNECTION_TIMEOUT_MS=30000
# RESYNC_CONCURRENCY=

# --- Server-side scans -------------------------------------------------------
# SCAN_VECTORIZE_CONCURRENCY=4

# --- Database pool -----------------------------------------------------------
# DB_POOL_MAX=10
# DB_IDLE_TIMEOUT_MS=10000
# DB_CONNECTION_TIMEOUT_MS=10000

# --- Debug logging (set to "true") -------------------------------------------
SHOW_VECTOR_LOGS=
VITE_SHOW_SCAN_LOGS=
