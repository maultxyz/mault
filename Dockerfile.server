FROM node:26-slim
RUN npm install -g pnpm@9.1.3

WORKDIR /app

# Set HuggingFace and CollectorVision caches to known paths inside the image
ENV HF_HOME=/app/.cache/huggingface
ENV COLLECTORVISION_CACHE=/app/.cache/collectorvision

# Copy manifests for layer caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches/ patches/
COPY packages/shared/package.json packages/shared/
COPY packages/server/package.json packages/server/
RUN pnpm install --frozen-lockfile

# Pre-download the pinned CollectorVision Milo embedder into the image at build
# time. Pinned repo/revision/sha256 must match packages/server/src/lib/models/
# model-registry.ts exactly - this duplicates that record inline (rather than
# importing the .ts source) so the source tree doesn't need to be copied in
# before this layer, keeping it cached as long as the pin doesn't change.
RUN node -e " \
  const crypto = require('crypto'); \
  const fs = require('fs'); \
  const path = require('path'); \
  const model = { \
    repo: 'HanClinto/milo', \
    revision: '9bcc5e809e936b8c5630d1e7101aae1de1e76621', \
    filename: 'model.onnx', \
    sha256: 'bd13d8d60383c69da04dce261f32e93fdaeaa8fd618fbc991e7385f71b3d45df', \
  }; \
  const dir = path.join(process.env.COLLECTORVISION_CACHE, 'models', model.sha256); \
  const dest = path.join(dir, model.filename); \
  fs.mkdirSync(dir, { recursive: true }); \
  const url = \`https://huggingface.co/\${model.repo}/resolve/\${model.revision}/\${model.filename}\`; \
  fetch(url).then(res => { \
    if (!res.ok) throw new Error(\`Failed to download \${url}: \${res.status}\`); \
    return res.arrayBuffer(); \
  }).then(buf => { \
    const digest = crypto.createHash('sha256').update(Buffer.from(buf)).digest('hex'); \
    if (digest !== model.sha256) throw new Error(\`Checksum mismatch: expected \${model.sha256}, got \${digest}\`); \
    fs.writeFileSync(dest, Buffer.from(buf)); \
    console.log('[build] Milo embedder model pre-downloaded and verified.'); \
  }).catch(e => { console.error(e); process.exit(1); }); \
"

# Pre-download the PaddleOCR detection/recognition models into the same
# sha256-keyed cache lib/models/model-registry.ts reads, so the first scan on a
# fresh container doesn't fetch them from the network.
RUN node -e " \
  const crypto = require('crypto'); \
  const fs = require('fs'); \
  const path = require('path'); \
  const repo = 'monkt/paddleocr-onnx'; \
  const revision = '7b02d0a30a07ba2b92ad1ff5a8941ae2c633de65'; \
  const files = [ \
    ['detection/v3/det.onnx', 'ee40e80071ba3a320d4efda75f3e22047a7d049e9bf7bcaaf9daea23fc21b935'], \
    ['languages/latin/rec.onnx', '614ffc2d6d3902d360fad7f1b0dd455ee45e877069d14c4e51a99dc4ef144409'], \
    ['languages/latin/dict.txt', '3c0a8a79b612653c25f765271714f71281e4e955962c153e272b7b8c1d2b13ff'], \
  ]; \
  Promise.all(files.map(async ([filename, sha256]) => { \
    const url = \`https://huggingface.co/\${repo}/resolve/\${revision}/\${filename}\`; \
    const res = await fetch(url); \
    if (!res.ok) throw new Error(\`Failed to download \${url}: \${res.status}\`); \
    const buf = Buffer.from(await res.arrayBuffer()); \
    const digest = crypto.createHash('sha256').update(buf).digest('hex'); \
    if (digest !== sha256) throw new Error(\`Checksum mismatch for \${filename}: expected \${sha256}, got \${digest}\`); \
    const dest = path.join(process.env.COLLECTORVISION_CACHE, 'models', sha256, filename); \
    fs.mkdirSync(path.dirname(dest), { recursive: true }); \
    fs.writeFileSync(dest, buf); \
  })).then(() => console.log('[build] PaddleOCR models pre-downloaded and verified.')) \
    .catch(e => { console.error(e); process.exit(1); }); \
"

# Copy source
COPY packages/shared/ packages/shared/
COPY packages/server/ packages/server/
# Drizzle migrations live at the repo root, referenced via packages/server's
# drizzle.config.ts `out: "../../drizzle"` - needed at runtime for
# AUTH_PROVIDER=local's db:migrate-local (see scripts/migrate-local.ts).
COPY drizzle/ drizzle/

# Build server (tsup bundles shared directly from .ts source)
RUN pnpm --filter @magic-vault/server build

# Runtime only - set after the build/install steps, since pnpm install would
# otherwise skip the devDependencies this build actually needs (tsup, tsx,
# drizzle-kit). own-auth (AUTH_PROVIDER=local) gates its own production
# safety checks behind this - e.g. it silently accepts a missing/weak
# OWN_AUTH_TOKEN_PEPPER, and its console-log email/SMS fallbacks silently
# "work" instead of refusing to run, unless NODE_ENV=production is set.
ENV NODE_ENV=production

EXPOSE 3001
CMD ["node", "packages/server/dist/index.js"]
