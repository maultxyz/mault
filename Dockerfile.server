FROM node:20-slim
RUN npm install -g corepack && corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# Set HuggingFace cache to a known path inside the image
ENV HF_HOME=/app/.cache/huggingface

# Copy manifests for layer caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json packages/shared/
COPY packages/server/package.json packages/server/
RUN pnpm install --frozen-lockfile

# Pre-download SigLIP model into the image at build time
# Run from packages/server so pnpm resolves @huggingface/transformers correctly
# This layer is cached as long as dependencies don't change
RUN cd packages/server && node -e " \
  const { SiglipVisionModel, AutoProcessor } = require('@huggingface/transformers'); \
  Promise.all([ \
    SiglipVisionModel.from_pretrained('Xenova/siglip-base-patch16-512', { dtype: 'q8' }), \
    AutoProcessor.from_pretrained('Xenova/siglip-base-patch16-512'), \
  ]).then(() => { console.log('[build] SigLIP model pre-downloaded.'); process.exit(0); }) \
    .catch(e => { console.error(e); process.exit(1); }); \
"

# Copy source
COPY packages/shared/ packages/shared/
COPY packages/server/ packages/server/
# Drizzle migrations live at the repo root, referenced via packages/server's
# drizzle.config.ts `out: "../../drizzle"` - needed at runtime for
# AUTH_PROVIDER=local's db:migrate-local (see scripts/migrate-local.ts).
COPY drizzle/ drizzle/

# Build server (tsup bundles shared directly from .ts source)
RUN pnpm --filter @magic-vault/server build

# Runtime only - set after the build/install steps, since pnpm install would
# otherwise skip the devDependencies this build actually needs (tsup, tsx,
# drizzle-kit). own-auth (AUTH_PROVIDER=local) gates its own production
# safety checks behind this - e.g. it silently accepts a missing/weak
# OWN_AUTH_TOKEN_PEPPER, and its console-log email/SMS fallbacks silently
# "work" instead of refusing to run, unless NODE_ENV=production is set.
ENV NODE_ENV=production

EXPOSE 3001
CMD ["node", "packages/server/dist/index.js"]
