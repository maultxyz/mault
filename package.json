{
  "name": "magic-vault-monorepo",
  "version": "1.0.209",
  "private": true,
  "scripts": {
    "dev": "turbo dev --filter=!@magic-vault/bot --filter=!@magic-vault/shortener",
    "dev:bot": "turbo dev --filter=@magic-vault/bot",
    "dev:shortener": "turbo dev --filter=@magic-vault/shortener",
    "build": "turbo build",
    "lint": "turbo lint",
    "uptime:sync": "node --env-file-if-exists=.env scripts/better-stack-uptime.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  },
  "packageManager": "pnpm@9.1.3",
  "pnpm": {
    "patchedDependencies": {
      "onnxruntime-react-native@1.24.3": "patches/onnxruntime-react-native@1.24.3.patch",
      "react-native-gesture-handler@3.3.0": "patches/react-native-gesture-handler@3.3.0.patch",
      "react-native-vision-camera@5.2.3": "patches/react-native-vision-camera@5.2.3.patch"
    },
    "packageExtensions": {
      "@hookform/resolvers": {
        "peerDependencies": {
          "zod": "^4.0.0"
        }
      }
    }
  }
}
