# =============================================================================
# Mault: self-hosted (docker compose)
# =============================================================================
# Runs the whole stack with `docker compose up`, including its own Postgres.
# No Neon account needed. Copy this file to .env and fill in the REQUIRED
# section. Everything under "Optional features" can be left as is: unset
# means the feature is off.
#
# VITE_* values are served to every browser (the web container writes them to
# env.js at start-up), so they are public. Never put a secret in a VITE_* variable.


# =============================================================================
# 1. REQUIRED
# =============================================================================

AUTH_PROVIDER=local
VITE_AUTH_PROVIDER=local

# Origin the web app is served from (CORS, links in Discord posts).
WEB_URL=http://localhost:8080

# Random string. Signs admin impersonation tokens.
IMPERSONATION_SECRET=

# 32+ random bytes, kept secret. Changing it signs everyone out.
OWN_AUTH_TOKEN_PEPPER=

# Password for the stack's own Postgres.
POSTGRES_PASSWORD=

# Leave unset to use the stack's own Postgres. Set only to point at another
# Postgres with pgvector. DATABASE_SSL=false for one without a TLS listener.
# DATABASE_URL=
# DATABASE_SSL=false


# =============================================================================
# 2. WEB APP (public, read by the web container at start-up)
# =============================================================================

VITE_APP_ENV=local
# Must match the latest firmware release in main.ino.
VITE_LATEST_FIRMWARE_VERSION=1.0.1
# Leave empty to call /api on the same origin (nginx proxies it). Set only
# when the API is served from a different origin.
# VITE_API_URL=
# Public URL of the API reference site (packages/api-docs). The web app links
# to it from Settings > Integrations; leave empty to hide the link.
# VITE_API_DOCS_URL=http://localhost:8081


# =============================================================================
# 3. PRICE SYNC
# =============================================================================
# Prices don't sync on their own. Schedule
# `node packages/server/dist/scripts/sync-prices.js` in the server container
# with cron (see README > Prices).

# --- Card API User-Agent ------------------------------------------------------
# Sent to every card and price source (Scryfall, tcgcsv, Cardmarket, ...).
# Sources block agents that overuse them, so give your install its own name
# rather than reusing someone else's. Defaults to Mault-SelfHosted/1.0.
# CARD_API_USER_AGENT=MyMault/1.0


# =============================================================================
# 4. OPTIONAL FEATURES (unset = off)
# =============================================================================

# --- Shareable monitor links -------------------------------------------------
# Random string. Signs no-login monitor links. Changing it invalidates every
# link already shared.
MONITOR_LINK_SECRET=

# --- Wi-Fi sorters (ESP32, firmware 2.10.0+) ---------------------------------
# URL the board connects to. Unset = the web origin. Boards only trust public
# CA certificates, so behind a self-signed or private-CA proxy use ws:// on
# the Docker host (8080 with /api, or 3001 without). Re-run Wi-Fi setup after
# changing it.
# SORTER_LINK_URL=ws://192.168.1.20:8080/api/sorter-link/device

# --- Email (resend.com) ------------------------------------------------------
# Password resets and org invites. Unset = invites are link-only. Without a
# verified domain, Resend only delivers to your own account's email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Object storage (scan photos and sound clips) ----------------------------
# Any S3-compatible private bucket. Files are served through short-lived
# presigned URLs. Empty bucket = store them in Postgres.
# Move existing images with `pnpm --filter @magic-vault/server migrate:scan-images`.
SCAN_IMAGE_BUCKET=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Discord bot -------------------------------------------------------------
# Start it with `docker compose --profile bot up`.
# Token and client ID from the Discord Developer Portal.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Random string shared by the bot and the server.
BOT_API_SECRET=
# Random string that lets CI post and clear the "deploying" announcement
# (POST/DELETE /announcements/deploy, X-Deploy-Key header). Unset = off.
DEPLOY_API_KEY=
BOT_PORT=3002
# Inside compose, the server and bot find each other by service name.
# Override only if one of them runs outside this stack.
# DOCKER_SERVER_URL=http://server:3001
# DOCKER_BOT_URL=http://bot:3002

# --- Donations (Buy Me a Coffee) ---------------------------------------------
# Posts each donation to Discord through the bot. Pick the channel (and the
# price update channel) in Admin > Discord channels.
# BUY_ME_A_COFFEE_WEBHOOK_SECRET=

# --- Error tracking (Rollbar) ------------------------------------------------
# The client token is public (built into the JS).
ROLLBAR_SERVER_TOKEN=
VITE_ROLLBAR_ACCESS_TOKEN=


# =============================================================================
# 5. TUNING AND DEBUGGING (defaults are fine)
# =============================================================================

# --- Admin card sync job -----------------------------------------------------
# Default cards embedded in parallel when a sync request does not choose
# its own count. The admin Card Image Vectors screen can set 1 to 32 per run.
VECTORIZE_CONCURRENCY=1
SYNC_INSERT_BATCH_SIZE=50
# SYNC_VECTORIZE_CONCURRENCY=
# SYNC_IMAGE_FETCH_DELAY_MS=200
# SYNC_DB_POOL_MAX=3
# SYNC_DB_IDLE_TIMEOUT_MS=60000
# SYNC_DB_CONNECTION_TIMEOUT_MS=30000
# RESYNC_CONCURRENCY=

# --- Server-side scans -------------------------------------------------------
# SCAN_VECTORIZE_CONCURRENCY=4

# --- Database pool -----------------------------------------------------------
# DB_POOL_MAX=10
# DB_IDLE_TIMEOUT_MS=10000
# DB_CONNECTION_TIMEOUT_MS=10000

# --- Debug logging (set to "true") -------------------------------------------
SHOW_VECTOR_LOGS=
VITE_SHOW_SCAN_LOGS=
