<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
    <AssemblyName>MaultScannerHelper</AssemblyName>
    <RootNamespace>MaultScannerHelper</RootNamespace>
    <Company>Mault LLC</Company>
    <Copyright>Copyright © Mault LLC</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAPS2.Sdk" Version="1.6.0" />
    <PackageReference Include="NAPS2.Images.Gdi" Version="1.6.0" />
    <PackageReference Include="NAPS2.Sdk.Worker.Win32" Version="1.6.0" />
  </ItemGroup>

</Project>
