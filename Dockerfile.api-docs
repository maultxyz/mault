FROM node:26-alpine AS builder
RUN npm install -g pnpm@9.1.3

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json packages/shared/
COPY packages/api-docs/package.json packages/api-docs/
RUN pnpm install --frozen-lockfile --filter @magic-vault/api-docs...

COPY packages/shared/ packages/shared/
COPY packages/api-docs/ packages/api-docs/

# Baked into the bundle at build time, like Dockerfile.web. Leave it empty when
# this container shares a network with the server, since nginx.api-docs.conf
# proxies /api to it; set it to the API's public origin otherwise.
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

RUN pnpm --filter @magic-vault/api-docs build

FROM nginx:alpine
COPY --from=builder /app/packages/api-docs/dist /usr/share/nginx/html
COPY nginx.api-docs.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
