# Must match the origin the web app is actually served from - CORS and
# Discord monitor-page links are built from this. localhost:5173 for
# `pnpm dev`; localhost:8080 for `docker compose up` (see docker-compose.yml).
# Since both read this same .env, switch it when you switch which one you're running.
WEB_URL=http://localhost:5173
PORT=3001

# "neon" (default) or "local". See auth/index.ts. Must match VITE_AUTH_PROVIDER
# below - the server and web app select their auth backend independently.
AUTH_PROVIDER=neon
VITE_AUTH_PROVIDER=neon

# --- AUTH_PROVIDER=neon --------------------------------------------------
# Get from neon.com
DATABASE_URL=
NEON_AUTH_URL=
VITE_NEON_DATA_API_URL=
VITE_NEON_AUTH_URL=

# --- AUTH_PROVIDER=local --------------------------------------------------
# Self-hosted: DATABASE_URL points at your own Postgres+pgvector instance
# (e.g. the docker-compose postgres service) instead of Neon's. Set
# DATABASE_SSL=false for a local/Docker Postgres with no TLS listener.
# DATABASE_URL=postgresql://mault:mault@localhost:5432/mault
# DATABASE_SSL=false
#
# Required in production; generate a random string of at least 32 bytes and
# keep it secret - own-auth uses it to hash sessions, tokens, and API keys
# before storing them. Do not change it once set, or every existing session
# is invalidated.
# OWN_AUTH_TOKEN_PEPPER=
#
# Only read by docker-compose.yml, to set the local Postgres container's
# password (and build its DATABASE_URL) - not read by the app itself.
# POSTGRES_PASSWORD=
#
# Optional - enables real email delivery for password reset and org invite
# notifications (see auth/local-email-provider.ts). Get a key from resend.com.
#
# Without a verified domain, Resend (like every transactional email provider -
# this isn't Resend-specific) only lets you send to the email address your
# Resend account itself is registered under, nobody else. That's enough for
# password reset on a single-user install (you're only ever resetting your
# own password), but NOT enough to email invites to anyone but yourself -
# invites always still work via a shareable link regardless (shown in the
# UI either way), it just won't also arrive by email for real recipients
# until you verify a domain at resend.com/domains and set RESEND_FROM_EMAIL
# to an address on it. Leave both unset to skip email entirely - password
# reset silently won't work and invites fall back to link-only, but nothing
# breaks.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# Generate yourself (any random string) - signs/verifies short-lived admin
# impersonation tokens (see middleware/auth.ts's signImpersonationToken).
# Distinct from the identity provider's own session/JWTs, which we only ever
# verify.
IMPERSONATION_SECRET=

# Optional - tuning for the admin card-image-vector sync job
VECTORIZE_CONCURRENCY=1
SYNC_INSERT_BATCH_SIZE=50
SCAN_VECTORIZE_CONCURRENCY=2

# Discord bot (packages/bot) - see the Discord Developer Portal for the
# application's bot token/client id, and generate BOT_API_SECRET yourself
# (any random string, shared between the server and the bot process).
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
BOT_API_SECRET=
SERVER_URL=http://localhost:3001
# Optional - registers commands to one guild instantly instead of globally
# (global registration can take up to an hour to propagate). Handy for local dev.
DISCORD_DEV_GUILD_ID=
# The bot's own inbound HTTP server (receives error notifications to post -
# see sendDiscordErrorNotification), and the URL the server uses to reach it.
BOT_PORT=3002
BOT_URL=http://localhost:3002

# Public variables for the React app
VITE_APP_ENV=local
VITE_LATEST_FIRMWARE_VERSION=1.0.1 # Must match the latest release in main.ino