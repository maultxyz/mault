# =============================================================================
# Magic Vault environment
# =============================================================================
# One root .env is read by the server, the Discord bot, Vite and
# docker compose. Copy this file to .env and fill in the REQUIRED section plus
# ONE of the two auth sections. Everything below "Optional features" can be
# left as is: unset means the feature is off.
#
# VITE_* values are baked into the web bundle at build time, so they're public
# and need a rebuild to change. Never put a secret in a VITE_* variable.


# =============================================================================
# 1. REQUIRED
# =============================================================================

# Origin the web app is served from (CORS, links in Discord posts).
# localhost:5173 for `pnpm dev`, localhost:8080 for `docker compose up`.
WEB_URL=http://localhost:5173
PORT=3001

# Random string. Signs admin impersonation tokens.
IMPERSONATION_SECRET=

# Which auth provider to use: "neon" (default) or "local". Both must match.
AUTH_PROVIDER=neon
VITE_AUTH_PROVIDER=neon


# =============================================================================
# 2a. AUTH: NEON (AUTH_PROVIDER=neon)
# =============================================================================
# Values from your project at neon.com.

DATABASE_URL=
NEON_AUTH_URL=
VITE_NEON_AUTH_URL=
VITE_NEON_DATA_API_URL=


# =============================================================================
# 2b. AUTH: SELF-HOSTED (AUTH_PROVIDER=local)
# =============================================================================
# Your own Postgres with pgvector. Under docker compose, DATABASE_URL defaults
# to the stack's own postgres service, so you only need POSTGRES_PASSWORD.

# DATABASE_URL=postgresql://mault:mault@localhost:5432/mault
# Set to false for a Postgres without a TLS listener.
# DATABASE_SSL=false
# Password for docker compose's postgres service.
# POSTGRES_PASSWORD=

# Required in production: 32+ random bytes, kept secret.
# Changing it signs everyone out.
# OWN_AUTH_TOKEN_PEPPER=


# =============================================================================
# 3. WEB APP BUILD (public, baked into the bundle)
# =============================================================================

VITE_APP_ENV=local
# Must match the latest firmware release in main.ino.
VITE_LATEST_FIRMWARE_VERSION=1.0.1
# Leave empty to call /api on the same origin (Vite proxy in dev, nginx in
# docker). Set only when the API is served from a different origin.
# VITE_API_URL=


# =============================================================================
# 4. DOCKER COMPOSE
# =============================================================================
# Only read by docker-compose.yml.

# The `prices` service pulls TCGplayer and Cardmarket prices. It checks every
# PRICE_SYNC_INTERVAL_HOURS but only downloads what changed upstream.
# Set to 0 if something else (cron, Coolify) already runs
# `node packages/server/dist/scripts/sync-prices.js`.
PRICE_SYNC_INTERVAL_HOURS=6
PRICE_SYNC_RETRY_MINUTES=10

# Inside compose, the server and bot find each other by service name, and the
# SERVER_URL/BOT_URL values in the Discord section are ignored. Override only
# if the bot or server runs outside this compose stack.
# DOCKER_SERVER_URL=http://server:3001
# DOCKER_BOT_URL=http://bot:3002


# =============================================================================
# 5. OPTIONAL FEATURES (unset = off)
# =============================================================================

# --- Shareable monitor links -------------------------------------------------
# Random string. Signs no-login monitor links. Changing it invalidates every
# link already shared.
MONITOR_LINK_SECRET=

# --- Email (resend.com) ------------------------------------------------------
# Password resets and org invites. Unset = invites are link-only. Without a
# verified domain, Resend only delivers to your own account's email.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# --- Object storage (scan photos and sound clips) ----------------------------
# Neon Object Storage or any S3-compatible private bucket. Files are served
# through short-lived presigned URLs. Empty bucket = store them in Postgres.
# Move existing images with `pnpm --filter @magic-vault/server migrate:scan-images`.
SCAN_IMAGE_BUCKET=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Billing (Stripe, neon only) ---------------------------------------------
# Unset = billing off: every org is unlimited and the billing UI is hidden.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_BUSINESS=
# Free plan limits: scans per day, sorters connected at once (across every
# browser), and sound rules (across all games). Business orgs are unlimited.
FREE_PLAN_DAILY_SCAN_LIMIT=50
FREE_PLAN_MAX_CONNECTED_SORTERS=1
FREE_PLAN_MAX_SOUND_RULES=1

# --- Discord bot (packages/bot) ----------------------------------------------
# Token and client ID from the Discord Developer Portal.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Random string shared by the bot and the server.
BOT_API_SECRET=
# How the bot and server reach each other under `pnpm dev`.
SERVER_URL=http://localhost:3001
BOT_URL=http://localhost:3002
BOT_PORT=3002
# Registers commands to one server instantly instead of globally (dev only).
DISCORD_DEV_GUILD_ID=

# --- Donations (Buy Me a Coffee) ---------------------------------------------
# Posts each donation to a Discord channel through the bot.
# BUY_ME_A_COFFEE_WEBHOOK_SECRET=
# DISCORD_DONATION_CHANNEL_ID=

# --- Error tracking (Rollbar) ------------------------------------------------
# The client token is public (built into the JS).
ROLLBAR_SERVER_TOKEN=
VITE_ROLLBAR_ACCESS_TOKEN=


# =============================================================================
# 6. TUNING AND DEBUGGING (defaults are fine)
# =============================================================================

# --- Admin card sync job -----------------------------------------------------
# Cards embedded in parallel, and cards per database insert.
VECTORIZE_CONCURRENCY=1
SYNC_INSERT_BATCH_SIZE=50
# Overrides VECTORIZE_CONCURRENCY for the sync job only.
# SYNC_VECTORIZE_CONCURRENCY=
# Pause between card image downloads, in ms.
# SYNC_IMAGE_FETCH_DELAY_MS=200
# The sync worker's own database pool.
# SYNC_DB_POOL_MAX=3
# SYNC_DB_IDLE_TIMEOUT_MS=60000
# SYNC_DB_CONNECTION_TIMEOUT_MS=30000
# scripts/resync-all.ts, defaults to VECTORIZE_CONCURRENCY.
# RESYNC_CONCURRENCY=

# --- Server-side scans -------------------------------------------------------
# Scans embedded at once when the browser falls back to the server.
# SCAN_VECTORIZE_CONCURRENCY=4

# --- Database pool -----------------------------------------------------------
# DB_POOL_MAX=10
# DB_IDLE_TIMEOUT_MS=10000
# DB_CONNECTION_TIMEOUT_MS=10000

# --- Debug logging (set to "true") -------------------------------------------
# SHOW_VECTOR_LOGS: each scan's server-side work (candidates, OCR, embedding).
# VITE_SHOW_SCAN_LOGS: the scanner's per-scan steps in the browser console.
SHOW_VECTOR_LOGS=
VITE_SHOW_SCAN_LOGS=
