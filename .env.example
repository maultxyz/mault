# Origin the web app is served from (CORS, Discord links). localhost:5173
# for `pnpm dev`, localhost:8080 for `docker compose up`.
WEB_URL=http://localhost:5173
PORT=3001

# "neon" (default) or "local" - must match VITE_AUTH_PROVIDER below.
AUTH_PROVIDER=neon
VITE_AUTH_PROVIDER=neon

# --- AUTH_PROVIDER=neon ----------------------------------------------------
# Get from neon.com
DATABASE_URL=
NEON_AUTH_URL=
VITE_NEON_DATA_API_URL=
VITE_NEON_AUTH_URL=

# --- AUTH_PROVIDER=local ----------------------------------------------------
# Your own Postgres+pgvector instance (e.g. docker-compose's postgres service).
# DATABASE_SSL=false for a local/Docker Postgres with no TLS listener.
# DATABASE_URL=postgresql://mault:mault@localhost:5432/mault
# DATABASE_SSL=false

# Required in production - random string, 32+ bytes, keep secret. Hashes
# sessions/tokens/API keys; changing it invalidates all existing sessions.
# OWN_AUTH_TOKEN_PEPPER=

# Only used by docker-compose.yml, to set the local Postgres container's password.
# POSTGRES_PASSWORD=

# Optional - real email delivery for password reset/org invites, via
# resend.com. Without a verified domain, Resend only sends to your own
# account's email - invites still work via a shareable link either way.
# Leave unset to skip email entirely (invites fall back to link-only).
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# Random string you generate - signs/verifies admin impersonation tokens.
IMPERSONATION_SECRET=

# Optional - tuning for the admin card-image-vector sync job
VECTORIZE_CONCURRENCY=1
SYNC_INSERT_BATCH_SIZE=50
SCAN_VECTORIZE_CONCURRENCY=2

# --- Stripe billing (AUTH_PROVIDER=neon only) -------------------------------
# From the Stripe dashboard. Leave unset to disable billing entirely - all
# orgs stay on the unlimited "free" plan, /billing routes 404, and the web
# app hides the billing UI.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_BUSINESS=
# Cards a free-plan org can scan per day. Default 50 if unset.
FREE_PLAN_DAILY_SCAN_LIMIT=50

# Discord bot (packages/bot) - token/client id from the Discord Developer
# Portal; BOT_API_SECRET is any random string shared with the server.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
BOT_API_SECRET=
SERVER_URL=http://localhost:3001
# Optional - registers commands to one guild instantly instead of globally.
DISCORD_DEV_GUILD_ID=
# Bot's own inbound HTTP server, and the URL the server uses to reach it.
BOT_PORT=3002
BOT_URL=http://localhost:3002

# Public variables for the React app
VITE_APP_ENV=local
VITE_LATEST_FIRMWARE_VERSION=1.0.1 # Must match the latest release in main.ino
