# --- General ----------------------------------------------------------------
# WEB_URL: origin the web app is served from (CORS, Discord links).
# localhost:5173 for `pnpm dev`, localhost:8080 for `docker compose up`.
WEB_URL=http://localhost:5173
PORT=3001
# Random string - signs admin impersonation tokens.
IMPERSONATION_SECRET=

# --- Auth -------------------------------------------------------------------
# "neon" (default) or "local". The two must match.
AUTH_PROVIDER=neon
VITE_AUTH_PROVIDER=neon

# neon: values from neon.com
DATABASE_URL=
NEON_AUTH_URL=
VITE_NEON_AUTH_URL=
VITE_NEON_DATA_API_URL=

# local: your own Postgres + pgvector (e.g. docker-compose's postgres service).
# DATABASE_URL=postgresql://mault:mault@localhost:5432/mault
# DATABASE_SSL=false                 # for Postgres without a TLS listener
# POSTGRES_PASSWORD=                 # docker-compose only
# OWN_AUTH_TOKEN_PEPPER=             # required in production: random 32+ bytes, secret; changing it invalidates all sessions

# --- Email (optional) -------------------------------------------------------
# resend.com, for password resets and org invites. Unset = invites are link-only.
# Without a verified domain, Resend only delivers to your own account's email.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# --- Vectorization (optional) -----------------------------------------------
# Admin sync job tuning.
VECTORIZE_CONCURRENCY=1
SYNC_INSERT_BATCH_SIZE=50
VECTORIZE_DEVICE=dml
# Defaults to fp32 (matches the in-browser WebGPU scan path exactly - see
# client-vectorize.ts) regardless of VECTORIZE_DEVICE. Only override to "q8"
# to trade search precision for lower sync-job memory/CPU use - a card
# synced at a different precision than the query embedding it's compared
# against lands measurably farther away in cosine distance, which can push
# genuine matches past DISTANCE_THRESHOLD / a collection's match %. Changing
# this after cards are already synced only affects newly (re)synced cards -
# re-run the sync for any game whose cards you want recomputed at the new
# precision.
# VECTORIZE_DTYPE=q8
# "false" = server-side scans vectorize only the whole card (skips art/name/
# bottom crops: lower memory/CPU, slightly less precise re-ranking). Doesn't
# affect the sync job or in-browser WebGPU scans.
# SCAN_VECTORIZE_REGIONS=false

# --- Stripe billing (neon only) ---------------------------------------------
# Leave unset to disable billing: every org gets the unlimited free plan and
# the web app hides billing UI.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_BUSINESS=
FREE_PLAN_DAILY_SCAN_LIMIT=50
# How many sorters a free-plan org can have connected at the same time,
# across every browser and computer. Business orgs are unlimited.
FREE_PLAN_MAX_CONNECTED_SORTERS=1

# --- Discord bot (packages/bot) ---------------------------------------------
# Token and client ID from the Discord Developer Portal.
# BOT_API_SECRET: any random string shared by the bot and server.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
BOT_API_SECRET=
SERVER_URL=http://localhost:3001
BOT_PORT=3002
BOT_URL=http://localhost:3002
# Optional: register commands to one guild instantly instead of globally.
DISCORD_DEV_GUILD_ID=

# --- Web app (public, baked into the bundle) --------------------------------
VITE_APP_ENV=local
# Must match the latest release in main.ino.
VITE_LATEST_FIRMWARE_VERSION=1.0.1

# --- Rollbar (optional) -----------------------------------------------------
# Leave both unset to disable. The client token is public (built into the JS).
ROLLBAR_SERVER_TOKEN=
VITE_ROLLBAR_ACCESS_TOKEN=
