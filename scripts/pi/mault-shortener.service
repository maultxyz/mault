[Unit]
Description=Mault link shortener
After=network.target postgresql.service

[Service]
Type=simple
WorkingDirectory=%h/mault
Environment=NODE_ENV=production
Environment=SHORTENER_HOST=127.0.0.1
Environment=SHORTENER_PORT=3003
ExecStart=/bin/bash %h/mault/scripts/pi/run-shortener.sh
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
