FROM node:26-slim
RUN npm install -g pnpm@9.1.3

WORKDIR /app

# Copy manifests for layer caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches/ patches/
COPY packages/shared/package.json packages/shared/
COPY packages/shortener/package.json packages/shortener/
RUN pnpm install --frozen-lockfile

# Copy source (tsup bundles shared directly from .ts source)
COPY packages/shared/ packages/shared/
COPY packages/shortener/ packages/shortener/
RUN pnpm --filter @magic-vault/shortener build

ENV NODE_ENV=production

USER node

EXPOSE 3003
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:' + (process.env.SHORTENER_PORT || 3003) + '/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"
CMD ["node", "packages/shortener/dist/index.js"]
